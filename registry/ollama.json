{
  "$comment": [
    "Tariffia Router — provider registry.",
    "Contains multiple providers: Ollama, OpenRouter, DeepInfra, OpenAI.",
    "This file is data, not code: adding a provider/model of an existing kind",
    "does not require a core change.",
    "",
    "Credentials are referenced only by environment-variable NAME (apiKeyEnv);",
    "no key value is ever stored here.",
    "",
    "A model is classified free ONLY from an explicit 0/0 price, never from its",
    "name or provider.",
    "",
    "OpenRouter free models were read live from https://openrouter.ai/api/v1/models",
    "where pricing.prompt == \"0\" and pricing.completion == \"0\" (verified 2026-10-05).",
    "DeepInfra models were read live from https://api.deepinfra.com/v1/openai/models",
    "(context_length and pricing verified 2026-10-05).",
    "",
    "Capabilities listed are only those the source explicitly reported: 'text' for",
    "all text-in models, 'vision' where image input is supported, and 'tools' where",
    "the OpenRouter API lists 'tools' in supported_parameters. Nothing else is",
    "inferred. Third-party cloud providers are capped at maxPrivacy 'public'."
  ],
  "providers": [
    {
      "id": "ollama",
      "kind": "openai-compat",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "apiKeyEnv": "OLLAMA_API_KEY",
      "apiKeyOptional": true,
      "maxPrivacy": "highly_confidential",
      "summary": "Local inference via Ollama. Private by construction: the bytes never leave the machine.",
      "freeTierNote": "Local models; there is no provider billing. Zero marginal cost.",
      "models": [
        {
          "id": "llama3.2",
          "capabilities": ["text", "tools"],
          "contextWindow": 131072,
          "price": { "inPerMTok": 0, "outPerMTok": 0 },
          "languages": { "*": 0.6 },
          "note": "EXAMPLE/UNVERIFIED: only usable if this model has been pulled locally.",
          "unverified": true
        },
        {
          "id": "qwen2.5-coder:7b",
