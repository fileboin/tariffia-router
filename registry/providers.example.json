{
  "$comment": [
    "Tariffia Router registry — TEMPLATE ONLY.",
    "Copy to registry/providers.local.json (gitignored) and fill in.",
    "No real API keys here: keys come from the environment via apiKeyEnv.",
    "This schema is a proposal and may change in MVP step 2.",
    "toSrisk: 'ok' | 'caution' | 'avoid' — 'avoid' providers are never routed by default."
  ],
  "defaultMode": "FREE_FIRST",
  "providers": [
    {
      "id": "ollama",
      "kind": "openai-compat",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "apiKeyEnv": "OLLAMA_API_KEY",
      "apiKeyOptional": true,
      "maxPrivacy": "highly_confidential",
      "toSrisk": "ok",
      "models": [
        {
          "id": "qwen2.5-coder:7b",
          "capabilities": ["text", "code", "json"],
          "contextWindow": 32768,
          "price": { "inPerMTok": 0, "outPerMTok": 0 },
          "quality": 0.6
        }
      ]
    },
    {
      "id": "groq",
      "kind": "openai-compat",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKeyEnv": "GROQ_API_KEY",
      "maxPrivacy": "internal",
      "toSrisk": "ok",
      "quota": { "requestsPerMinute": 30, "requestsPerDay": 1000 },
      "models": [
        {
          "id": "REPLACE_WITH_CURRENT_FREE_MODEL_ID",
          "capabilities": ["text", "code", "tools", "json"],
          "contextWindow": 131072,
          "price": { "inPerMTok": 0, "outPerMTok": 0 },
          "quality": 0.75,
          "note": "Verify the free tier and the model id against the provider's docs before use."
        }
      ]
    }
  ]
}
