# Tariffia Router — example environment. Copy to .env (gitignored) and fill in.
#
# This is a template only. No real keys belong in the repository.

# --- Router server ---
TARIFFIA_HOST=127.0.0.1
TARIFFIA_PORT=8910
# Token clients must present. Generate: openssl rand -hex 32
TARIFFIA_TOKEN=
# Default routing mode: FREE_ONLY | FREE_FIRST | BALANCED | CUSTOM
TARIFFIA_MODE=FREE_ONLY
# Optional server-owned maximum USD rate per 1M input AND output tokens.
# If unset or invalid, paid candidates are disabled. This is NOT a per-request budget.
# TARIFFIA_MAX_PRICE_PER_MTOK=1.00

# --- Local provider (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Free-tier provider keys (all optional; absent provider is dropped) ---
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_KEY=

# --- Optional paid providers (never used while mode is FREE_ONLY) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
